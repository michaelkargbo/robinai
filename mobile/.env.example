# RobinAI Companion Mobile App — Environment Variables
# Connect to your RobinAI Express backend:
# For local physical device testing on Wi-Fi, use your machine's LAN IP, e.g.:
# EXPO_PUBLIC_API_URL=http://192.168.1.100:4000
# For local emulator:
# Android emulator: http://10.0.2.2:4000
# iOS simulator: http://localhost:4000
# For production cloud deployment (Vercel / Custom Domain):
EXPO_PUBLIC_API_URL=https://robinai.digital

# Optional RevenueCat API Keys for iOS & Android in-app subscriptions:
EXPO_PUBLIC_REVENUECAT_APPLE_KEY=appl_your_ios_revenuecat_key
EXPO_PUBLIC_REVENUECAT_GOOGLE_KEY=goog_your_android_revenuecat_key
