# ============================================================
# RobinAI — Production Environment Variables
# Configure these in your Vercel Project Settings → Environment Variables
# ============================================================

# Google Gemini API Key (Required for live AI reasoning)
# Get a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Etherscan API Key (Optional: for live EVM transaction & wallet lookup)
# Get a free key at: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# CoinGecko API Key (Optional: for high-volume spot pricing. Free tier works without a key)
COINGECKO_API_KEY=

# Secret key used to sign JWT authentication sessions
# Generate any random 32-64 character string
JWT_SECRET=robinai-master-production-jwt-secret-2026

# Server port (used for local development; Vercel handles this automatically)
PORT=4000
