# ============================================================
# RobinAI — Production Environment Variables
# ============================================================
# Copy this file to .env for local development
# On Railway / Render / VPS: add these in the platform dashboard
# NEVER commit your real .env file to Git
# ============================================================

# ── AI Provider (Required for live AI responses) ─────────────
# Get a free Gemini key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Blockchain Data (Optional) ───────────────────────────────
# Enables live transaction hash and wallet address lookups
# Get a free key at: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# ── Market Data (Optional) ───────────────────────────────────
# Free tier works without a key. Add a Pro key for higher rate limits.
# Get a key at: https://www.coingecko.com/en/api
COINGECKO_API_KEY=

# ── Authentication ───────────────────────────────────────────
# IMPORTANT: Change this to a long random string in production!
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_IN_PRODUCTION

# ── CORS (Required in production) ────────────────────────────
# Comma-separated list of allowed frontend origins
# Example: ALLOWED_ORIGINS=https://robinai.digital,https://www.robinai.digital
ALLOWED_ORIGINS=https://robinai.digital,https://www.robinai.digital

# ── Database Storage (Optional) ──────────────────────────────
# Path where the JSON data store is saved on disk.
# If not set, defaults to ./data/robin_store.json
# On ephemeral platforms (Vercel), data resets per deployment.
# DATA_DIR=/var/data/robinai

# ── Server ───────────────────────────────────────────────────
# Port for local development. On Railway/Render this is set automatically.
PORT=4000
NODE_ENV=development
